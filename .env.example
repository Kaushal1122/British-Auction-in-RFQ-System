# ==============================================================================
# British Auction in RFQ System - Environment Configuration Template
# Copy this file to .env and configure values according to your environment.
# ==============================================================================

# Backend Server Configuration
PROJECT_NAME="British Auction RFQ System"
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@localhost:5432/<YOUR_DATABASE_NAME>

# Frontend / CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8000
